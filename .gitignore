# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Environment
.env
.venv/
venv/

# Data: do not track private or raw data
data/**
!data/
!data/raw/
!data/processed/
!data/raw/.gitkeep
!data/processed/.gitkeep

# Results and figures can be regenerated
results/**
!results/
!results/uncorrected/
!results/fwe_corrected/
!results/uncorrected/.gitkeep
!results/fwe_corrected/.gitkeep

figures/**
!figures/
!figures/brain_maps/
!figures/channel_plots/
!figures/brain_maps/.gitkeep
!figures/channel_plots/.gitkeep

# Large or sensitive files
*.mat
*.snirf
*.nirs
*.csv
*.tsv
*.xlsx
*.xls
*.h5
*.pkl
*.sav

# System files
.DS_Store
reference_matlab/
assets/*.npz
local_experiments/
